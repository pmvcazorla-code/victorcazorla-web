{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "victorcazorla-web",
  // Igual que el compatibility_date con el que ya despliega el proyecto
  // (ver Settings > Builds en el dashboard) para no cambiar el
  // comportamiento del runtime de golpe.
  "compatibility_date": "2026-01-15",
  // Necesario para que Cloudflare Pages use este archivo como
  // configuración de producción en vez de solo para desarrollo local.
  // https://developers.cloudflare.com/pages/functions/wrangler-configuration/
  "pages_build_output_dir": "./dist",
  "kv_namespaces": [
    {
      "binding": "CONTACT_RATE_LIMIT",
      "id": "ab2a109039ae40639b48e5bdcc75401f"
    }
  ],
  "vars": {
    // No son secretos (ya son públicos como enlaces mailto en el propio
    // sitio). RESEND_API_KEY y HCAPTCHA_SECRET sí lo son y se
    // configuran aparte, como variables de entorno cifradas de la
    // Function (Settings > Environment variables), nunca aquí. La
    // sitekey pública de hCaptcha (PUBLIC_HCAPTCHA_SITE_KEY) es otra
    // variable distinta: no va aquí tampoco, sino como variable de
    // *build* de Astro (la usa ContactForm.astro al compilar el sitio).
    "CONTACT_TO_EMAIL": "contacto@victorcazorla.com",
    "CONTACT_FROM_EMAIL": "web@victorcazorla.com"
  }
}
