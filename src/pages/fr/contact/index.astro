---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContactForm from "../../../components/ContactForm.astro";
import { navItems, contactCopy } from "../../../data/i18n";

const copy = contactCopy.fr;
const title = "Contact - Víctor Cazorla Fernández";
const description = "Formulaire de contact de Víctor Cazorla Fernández : direction IT, sciences de l'environnement et éthique professionnelle.";
---
<BaseLayout title={title} description={description} lang="fr" navItems={navItems.fr}>
  <div class="container narrow">
    <h1>{copy.heading}</h1>
    <p class="page-intro">{copy.intro}</p>
    <ContactForm copy={copy} directEmail="contacto@victorcazorla.com" />
  </div>
</BaseLayout>
