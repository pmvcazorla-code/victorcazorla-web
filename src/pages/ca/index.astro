---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ObfuscatedEmail from "../../components/ObfuscatedEmail.astro";
import { navItems } from "../../data/i18n";

const title = "Víctor Cazorla Fernández — Direcció IT, Gestió Ambiental i Ètica Professional";
const description = "Direcció IT · Gestió Ambiental · Ètica professional";
---

<BaseLayout title={title} description={description} image="/images/og/home.png" imageAlt="Víctor Cazorla Fernández" lang="ca" navItems={navItems.ca}>
  <section id="sobre-mi">
    <h2>Sobre mi</h2>
    <p class="no-margin-top name-lead"><strong>Víctor Cazorla Fernández</strong></p>
    <p>
      Víctor Cazorla Fernández és científic ambiental, investigador i responsable d'operacions tecnològiques en entorns internacionals. La seva activitat professional i acadèmica se centra en les ciències ambientals, la filosofia del dret i la gestió d'organitzacions tecnològiques.
    </p>
    <p>
      És president del Comitè d'Ètica i Deontologia del Col·legi Oficial d'Ambientòlegs de Catalunya, perit judicial del Departament de Justícia i Qualitat Democràtica de la Generalitat de Catalunya en matèria ambiental, docent col·laborador del Col·legi Oficial d'Ambientòlegs de Catalunya i membre de la Borsa de Persones Expertes de l'Agència de Qualitat Universitària d'Andorra (AQUA), on participa en l'avaluació externa de titulacions universitàries de Ciències Ambientals i Ciències de la Terra.
    </p>
    <p>
      És autor publicat en revistes científiques indexades a Scopus i Web of Science en els àmbits de la filosofia jurídica, la lògica normativa, el dret administratiu i diverses especialitats de les ciències biològiques. Desenvolupa la seva activitat investigadora amb filiació universitària i col·legial.
    </p>
    <p>
      La seva activitat professional se centra en la direcció d'operacions i el govern de serveis en organitzacions tecnològiques. Ha dirigit equips especialitzats en arquitectura i enginyeria cloud i on-premises, així com en ciberseguretat, i ha gestionat grans comptes enterprise.
    </p>
    <p>
      Compta amb formació universitària de nivell MECES 3 (EQF 7). La relació completa de titulacions i estudis d'especialització està disponible a l'apartat de Formació.
    </p>

    <a
      href="https://www.linkedin.com/in/victorcazorla-f/"
      target="_blank"
      rel="noopener noreferrer"
      class="linkedin-card"
    >
      <img
        src="/img/linkedin_face.jpg"
        alt="Víctor Cazorla Fernández"
        width="600"
        height="600"
        class="linkedin-card__photo"
      />
      <div class="linkedin-card__body">
        <span class="linkedin-card__badge">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </span>
        <p class="linkedin-card__lead">
          Pots seguir la meva activitat professional i les meves publicacions a LinkedIn.
        </p>
      </div>
    </a>

    <a
      href="https://scholar.google.com/citations?view_op=list_works&hl=es&hl=es&user=2-WDnroAAAAJ"
      target="_blank"
      rel="noopener noreferrer"
      class="scholar-card"
    >
      <img
        src="/img/linkedin_face.jpg"
        alt="Víctor Cazorla Fernández"
        width="600"
        height="600"
        class="scholar-card__photo"
      />
      <div class="scholar-card__body">
        <span class="scholar-card__badge">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/></svg>
          Google Acadèmic
        </span>
        <p class="scholar-card__lead">
          Consulta les meves publicacions científiques a Google Acadèmic.
        </p>
      </div>
    </a>

    <a
      href="https://www.researchgate.net/profile/Victor-Cazorla-Fernandez"
      target="_blank"
      rel="noopener noreferrer"
      class="researchgate-card"
    >
      <img
        src="/img/linkedin_face.jpg"
        alt="Víctor Cazorla Fernández"
        width="600"
        height="600"
        class="researchgate-card__photo"
      />
      <div class="researchgate-card__body">
        <span class="researchgate-card__badge">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.586 0c-.818 0-1.508.19-2.073.565-.563.377-.97.936-1.213 1.68a3.193 3.193 0 0 0-.112.437 8.365 8.365 0 0 0-.078.53 9 9 0 0 0-.05.727c-.01.282-.013.621-.013 1.016a31.121 31.123 0 0 0 .014 1.017 9 9 0 0 0 .05.727 7.946 7.946 0 0 0 .077.53h-.005a3.334 3.334 0 0 0 .113.438c.245.743.65 1.303 1.214 1.68.565.376 1.256.564 2.075.564.8 0 1.536-.213 2.105-.603.57-.39.94-.916 1.175-1.65.076-.235.135-.558.177-.93a10.9 10.9 0 0 0 .043-1.207v-.82c0-.095-.047-.142-.14-.142h-3.064c-.094 0-.14.047-.14.141v.956c0 .094.046.14.14.14h1.666c.056 0 .084.03.084.086 0 .36 0 .62-.036.865-.038.244-.1.447-.147.606-.108.385-.348.664-.638.876-.29.212-.738.35-1.227.35-.545 0-.901-.15-1.21-.353-.306-.203-.517-.454-.67-.915a3.136 3.136 0 0 1-.147-.762 17.366 17.367 0 0 1-.034-.656c-.01-.26-.014-.572-.014-.939a26.401 26.403 0 0 1 .014-.938 15.821 15.822 0 0 1 .035-.656 3.19 3.19 0 0 1 .148-.76 1.89 1.89 0 0 1 .742-1.01c.344-.244.593-.352 1.137-.352.508 0 .815.096 1.144.303.33.207.528.492.764.925.047.094.111.118.198.07l1.044-.43c.075-.048.09-.115.042-.199a3.549 3.549 0 0 0-.466-.742 3 3 0 0 0-.679-.607 3.313 3.313 0 0 0-.903-.41A4.068 4.068 0 0 0 19.586 0zM8.217 5.836c-1.69 0-3.036.086-4.297.086-1.146 0-2.291 0-3.007-.029v.831l1.088.2c.744.144 1.174.488 1.174 2.264v11.288c0 1.777-.43 2.12-1.174 2.263l-1.088.2v.832c.773-.029 2.12-.086 3.465-.086 1.29 0 2.951.057 3.667.086v-.831l-1.49-.2c-.773-.115-1.174-.487-1.174-2.264v-4.784c.688.057 1.29.057 2.206.057 1.748 3.123 3.41 5.472 4.355 6.56.86 1.032 2.177 1.691 3.839 1.691.487 0 1.003-.086 1.318-.23v-.744c-1.031 0-2.063-.716-2.808-1.518-1.26-1.376-2.95-3.582-4.355-6.074 2.32-.545 4.04-2.722 4.04-4.9 0-3.208-2.492-4.698-5.758-4.698zm-.515 1.29c2.406 0 3.839 1.26 3.839 3.552 0 2.263-1.547 3.782-4.097 3.782-.974 0-1.404-.03-2.063-.086v-7.19c.66-.059 1.547-.059 2.32-.059z"/></svg>
          ResearchGate
        </span>
        <p class="researchgate-card__lead">
          Consulta les meves publicacions científiques a ResearchGate.
        </p>
      </div>
    </a>

    <p class="contact-line">
      Vols posar-te en contacte? Escriu a <ObfuscatedEmail address="contacto@victorcazorla.com" />.
    </p>
  </section>
</BaseLayout>
