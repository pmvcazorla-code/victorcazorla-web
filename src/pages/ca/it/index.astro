---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { navItems } from "../../../data/i18n";
---

<BaseLayout
  title="Direcció i Governança de TI - Víctor Cazorla Fernández"
  description="Direcció i governança de TI: infraestructura cloud i on-premise, ciberseguretat i transformació digital amb criteri ètic i organitzatiu."
  image="/images/og/it.svg"
