---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContactForm from "../../../components/ContactForm.astro";
import { navItems, contactCopy } from "../../../data/i18n";

const copy = contactCopy.en;
const title = "Contact - Víctor Cazorla Fernández";
const description = "Contact form for Víctor Cazorla Fernández: IT management, environmental science and professional ethics.";
---
<BaseLayout title={title} description={description} lang="en" navItems={navItems.en}>
  <div class="container narrow">
    <h1>{copy.heading}</h1>
    <p class="page-intro">{copy.intro}</p>
    <ContactForm copy={copy} directEmail="contacto@victorcazorla.com" />
  </div>
</BaseLayout>
