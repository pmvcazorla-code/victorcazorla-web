            </div>
          </div>
          <div class="career-card__role">
            <span class="career-card__title">IT Quality &amp; Knowledge Manager</span>
            <span class="career-card__specialty">ITIL Standards &amp; Knowledge Strategy</span>
          </div>
        </article>
      </div>
    </section>

    <section>
