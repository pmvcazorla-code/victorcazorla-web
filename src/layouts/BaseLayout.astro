---
import "../styles/global.css";

type NavItem = {
  href: string;
  label: string;
};

import { languages, routes, type LanguageOption } from "../data/i18n";

type BaseLayoutProps = {
  title?: string;
  description?: string;
  image?: string | null;
  imageAlt?: string;
  lang?: "es" | "en" | "fr" | "ca";
  navItems?: NavItem[];
};

const {
  title = "Víctor Cazorla Fernández",
  description = "Dirección IT · Ciencias Ambientales · Ética profesional",
  image = null,
  imageAlt = "",
  lang = "es",
  navItems = [],
} = Astro.props as BaseLayoutProps;

const currentPath = Astro.url.pathname;
// Compare ignoring a trailing slash so this keeps matching regardless of
// whether route.slugs (or the incoming URL) carries one.
const stripSlash = (path: string) =>
  path.endsWith("/") && path !== "/" ? path.slice(0, -1) : path;
const normalizedPath = stripSlash(currentPath);
const currentRoute = routes.find((route) =>
  Object.values(route.slugs).some((slug) => stripSlash(slug) === normalizedPath)
) ?? routes[0];

const languageHref = (code: "es" | "en" | "fr" | "ca") => currentRoute.slugs[code];
const siteUrl = typeof Astro.site === "string" ? Astro.site.replace(/\/$/, "") : Astro.url.origin;
const localeMap = {
  es: "es_ES",
  en: "en_US",
  fr: "fr_FR",
  ca: "ca_ES",
};
const fullUrl = (path: string) => `${siteUrl}${path}`;

const currentLabel = currentRoute.labels[lang];

const menuWord: Record<"es" | "en" | "fr" | "ca", string> = {
  es: "Menú",
  en: "Menu",
  fr: "Menu",
  ca: "Menú",
};

const isActiveHref = (href: string) => stripSlash(currentPath) === stripSlash(href);
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- Se coloca lo antes posible para minimizar el parpadeo en
         visitantes que van a ser redirigidos a su idioma. Archivo
         externo (no inline) por la CSP de public/_headers. -->
    <script is:inline src="/scripts/lang-redirect.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeMap[lang]} />
    <meta property="og:url" content={fullUrl(currentPath)} />
    <link rel="canonical" href={fullUrl(currentPath)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#070b14" />
    <link rel="alternate" hreflang="es" href={fullUrl(currentRoute.slugs.es)} />
    <link rel="alternate" hreflang="en" href={fullUrl(currentRoute.slugs.en)} />
    <link rel="alternate" hreflang="fr" href={fullUrl(currentRoute.slugs.fr)} />
    <link rel="alternate" hreflang="ca" href={fullUrl(currentRoute.slugs.ca)} />
    <link rel="alternate" hreflang="x-default" href={fullUrl(currentRoute.slugs.es)} />
    {image ? <meta property="og:image" content={fullUrl(image)} /> : null}
    {image ? <meta name="twitter:card" content="summary_large_image" /> : null}
    {image ? <meta name="twitter:image" content={fullUrl(image)} /> : null}
    {image && imageAlt ? <meta property="og:image:alt" content={imageAlt} /> : null}
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Víctor Cazorla Fernández",
      url: siteUrl,
      email: "info@victorcazorla.com",
      image: `${siteUrl}/img/linkedin_face.jpg`,
      jobTitle: "IT Management · Environmental Science · Professional Ethics",
      worksFor: {
        "@type": "Organization",
        name: "Independent Professional",
      },
      alumniOf: [
        { "@type": "CollegeOrUniversity", name: "UNED (Universidad Nacional de Educación a Distancia)" },
        { "@type": "CollegeOrUniversity", name: "UNIR (Universidad Internacional de La Rioja)" },
        { "@type": "CollegeOrUniversity", name: "URJC (Universidad Rey Juan Carlos)" },
        { "@type": "CollegeOrUniversity", name: "UCLM (Universidad de Castilla-La Mancha)" },
        { "@type": "CollegeOrUniversity", name: "UCMA (Universidad Camilo José Cela)" },
      ],
      memberOf: {
        "@type": "Organization",
        name: "Col·legi d'Ambientòlegs de Catalunya (COAMB)",
        url: "https://www.coamb.cat",
      },
      knowsLanguage: ["es", "en", "fr", "ca"],
      sameAs: [
        "https://www.linkedin.com/in/victorcazorla-f/",
        "https://orcid.org/0009-0009-7976-9691",
        "https://www.credly.com/users/victor-cazorla-fernandez/badges",
      ],
      knowsAbout: [
        "IT Management",
        "Environmental Science",
        "Professional Ethics",
        "Cloud Architecture",
        "Digital Transformation",
      ],
    })} />
    <!-- Fuentes autoalojadas (antes se pedían a Google Fonts en cada
         visita: 2 dominios externos + una petición CSS bloqueante antes
         de saber siquiera qué archivos de fuente pedir). Son variables
         (cubren todo el rango de peso 100-900 en un solo archivo por
         subset), así que solo hacen falta 2 subconjuntos Unicode por
         familia: "latin" (para el 95%+ del texto real) y "latin-ext"
         (para los caracteres acentuados menos comunes de fr/ca). -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/playfair-latin.woff2" crossorigin />

    <style>
      @font-face {
        font-family: "Inter";
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url("/fonts/inter-latin.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Inter";
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url("/fonts/inter-latin-ext.woff2") format("woff2");
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: "Playfair Display";
        font-style: normal;
        font-weight: 400 900;
        font-display: swap;
        src: url("/fonts/playfair-latin.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Playfair Display";
        font-style: normal;
        font-weight: 400 900;
        font-display: swap;
        src: url("/fonts/playfair-latin-ext.woff2") format("woff2");
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }

      :root {
        --bg-main: #070b14;
        --bg-header: rgba(7, 11, 20, 0.88);
        --text-main: #e6e9ef;
        --text-muted: #b6bcc8;
        --accent: #8fb3ff;
        --accent-soft: rgba(143, 179, 255, 0.15);
        --border-soft: rgba(255, 255, 255, 0.08);
        --accent-gold: #d4af37;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Inter", system-ui, sans-serif;
        background: radial-gradient(
            1200px 600px at 50% -200px,
            #121a2f 0%,
            transparent 70%
          ),
          var(--bg-main);
        color: var(--text-main);
        line-height: 1.75;
      }

      /* ===== HEADER ===== */
      header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: linear-gradient(
          to bottom,
          rgba(18, 26, 47, 0.92),
          rgba(7, 11, 20, 0.88)
        );
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(212, 175, 55, 0.25);
      }

      .header-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1.1rem 1.5rem 1.2rem;
        text-align: center;
      }

      header h1 {
        font-family: "Playfair Display", serif;
        font-size: clamp(2.1rem, 4vw, 3.4rem);
        margin: 0;
        letter-spacing: 0.02em;
      }

      .subtitle {
        margin-top: 0.4rem;
        font-size: 0.8rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--text-muted);
      }

      nav {
        margin-top: 1rem;
        display: flex;
        justify-content: center;
        gap: 0.6rem;
        flex-wrap: nowrap;
      }

      nav a {
        padding: 0.45rem 1rem;
        border-radius: 999px;
        border: 1px solid var(--border-soft);
        color: var(--text-main);
        text-decoration: none;
        font-size: 0.88rem;
        background: rgba(255, 255, 255, 0.03);
        white-space: nowrap;
        transition: all 0.3s cubic-bezier(0.23, 1, 0.320, 1);
      }

      .lang-switch-group {
        margin-top: 1rem;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .lang-switch {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 0.55rem;
        padding: 0.45rem 0.9rem;
        border-radius: 999px;
        border: 1px solid var(--border-soft);
        color: var(--accent);
        text-decoration: none;
        font-size: 0.82rem;
        transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
      }

      .lang-switch.active {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.12);
      }

      .lang-switch .flag-icon {
        display: inline-flex;
        width: 1.1rem;
        height: 0.85rem;
        min-width: 1.1rem;
      }

      .lang-switch svg {
        width: 100%;
        height: auto;
        display: block;
      }

      .lang-switch:hover {
        border-color: var(--accent-gold);
        background: rgba(212, 175, 55, 0.08);
        transform: translateY(-1px);
      }

      nav a:hover {
        border-color: var(--accent-gold);
        background: rgba(212, 175, 55, 0.1);
        transform: translateY(-2px);
      }

      nav a:focus {
        outline: 2px solid var(--accent-gold);
        outline-offset: 2px;
      }

      nav a.active {
        border-color: var(--accent-gold);
        background: linear-gradient(
          145deg,
          rgba(212, 175, 55, 0.18),
          rgba(212, 175, 55, 0.05)
        );
        box-shadow:
          0 4px 18px rgba(212, 175, 55, 0.25),
          inset 0 0 0 1px rgba(212, 175, 55, 0.35);
      }

      /* El header móvil sustituye a .header-inner por debajo de 768px
         (ver media query TABLET más abajo); en escritorio permanece oculto. */
      .header-mobile {
        display: none;
      }

      /* ===== MAIN ===== */
      main {
        max-width: 820px;
        margin: 0 auto;
        padding: 3.2rem 1.6rem 5.5rem;
      }

      h2 {
        font-family: "Playfair Display", serif;
        font-size: 2rem;
        margin-top: 3rem;
        margin-bottom: 1.2rem;
        line-height: 1.2;
        letter-spacing: -0.01em;
      }

      h1 {
        letter-spacing: -0.01em;
        line-height: 1.1;
      }

      p {
        margin: 0 0 1.6rem;
        line-height: 1.8;
      }

      .editorial-text p {
        margin-bottom: 2.2rem;
      }

      footer {
        border-top: 1px solid var(--border-soft);
        text-align: center;
        padding: 2.5rem 1rem;
        font-size: 0.85rem;
        color: var(--text-muted);
        opacity: 0.7;
        transition: opacity 0.3s ease;
      }

      footer:hover {
        opacity: 1;
      }

      /* ===== CARD/GRID OPTIMIZATION ===== */
      .cert-badge {
        transition: all 0.25s ease;
      }

      .cert-badge:hover {
        background: rgba(255, 255, 255, 0.05) !important;
        border-color: rgba(212, 175, 55, 0.4) !important;
        transform: translateY(-2px);
      }

      /* Responsive card padding */
      @media (max-width: 480px) {
        .cert-badge {
          padding: 0.9rem !important;
          gap: 0.8rem !important;
        }

        .cert-badge .cert-badge__icon {
          width: 40px !important;
          height: 40px !important;
        }

        .cert-badge .cert-badge__title,
        .cert-badge .cert-badge__subtitle {
          font-size: 0.8rem !important;
        }
      }

      /* ===== TABLET / MOBILE HEADER (<768px) ===== */
      @media (max-width: 768px) {
        .header-inner {
          display: none;
        }

        .header-mobile {
          display: flex;
          flex-direction: column;
        }

        /* Franja de idioma: siempre visible, antes que cualquier otro
           texto, para que cambiar de idioma no dependa de entender el
           idioma actual. */
        .flag-strip {
          display: flex;
          justify-content: center;
          gap: 0.4rem;
          padding: 0.4rem 0.6rem;
          border-bottom: 1px solid var(--border-soft);
          background: rgba(255, 255, 255, 0.015);
        }

        .flag-btn {
          display: flex;
          align-items: center;
          gap: 0.3rem;
          padding: 0.28rem 0.5rem;
          border-radius: 999px;
          border: 1px solid transparent;
          color: var(--text-muted);
          font-size: 0.65rem;
          font-weight: 600;
          letter-spacing: 0.02em;
          text-decoration: none;
        }

        .flag-btn .flag-icon {
          width: 1rem;
          height: 0.76rem;
          min-width: 1rem;
        }

        .flag-btn.active {
          color: var(--accent);
          border-color: rgba(143, 179, 255, 0.35);
          background: rgba(143, 179, 255, 0.08);
        }

        .flag-btn:focus-visible {
          outline: 2px solid var(--accent-gold);
          outline-offset: 1px;
        }

        .brand-row {
          padding: 0.75rem 0.9rem 0.55rem;
          text-align: center;
        }

        .brand-name {
          font-family: "Playfair Display", serif;
          font-size: 1.02rem;
          line-height: 1.25;
          letter-spacing: 0.01em;
        }

        /* Barra de sección: abre/cierra el menú y siempre indica en
           qué sección está el usuario. */
        .section-bar {
          width: 100%;
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 0.5rem;
          min-height: 46px;
          border: none;
          border-top: 1px solid var(--border-soft);
          background: rgba(255, 255, 255, 0.02);
          color: var(--text-main);
          font-family: inherit;
          font-size: 0.82rem;
          font-weight: 500;
          cursor: pointer;
          padding: 0;
        }

        .section-bar b {
          color: var(--accent-gold);
          font-weight: 600;
        }

        .section-bar:focus-visible {
          outline: 2px solid var(--accent-gold);
          outline-offset: -2px;
        }

        .burger-icon {
          width: 17px;
          height: 17px;
          flex-shrink: 0;
        }

        .burger-icon .icon-close {
          display: none;
        }

        .section-bar.open .burger-icon .icon-open {
          display: none;
        }

        .section-bar.open .burger-icon .icon-close {
          display: block;
        }

        .section-bar .chevron {
          width: 12px;
          height: 12px;
          flex-shrink: 0;
          transition: transform 0.25s ease;
        }

        .section-bar.open .chevron {
          transform: rotate(180deg);
        }

        .mobile-menu-panel {
          max-height: 0;
          overflow: hidden;
          transition: max-height 0.28s ease;
        }

        .mobile-menu-panel.open {
          max-height: 400px;
          border-top: 1px solid var(--border-soft);
        }

        .mobile-menu-panel nav {
          display: flex;
          flex-direction: column;
          padding: 0.4rem;
        }

        .mobile-menu-panel nav a {
          display: flex;
          align-items: center;
          min-height: 48px;
          padding: 0 0.8rem;
          color: var(--text-main);
          text-decoration: none;
          font-size: 0.9rem;
          border-radius: 10px;
        }

        .mobile-menu-panel nav a + a {
          margin-top: 2px;
        }

        .mobile-menu-panel nav a.active {
          color: var(--accent-gold);
          background: rgba(212, 175, 55, 0.08);
          font-weight: 600;
        }

        .mobile-menu-panel nav a:active {
          background: rgba(255, 255, 255, 0.06);
        }

        .mobile-menu-panel nav a:focus-visible {
          outline: 2px solid var(--accent-gold);
          outline-offset: -2px;
        }

        main {
          padding: 1.75rem 1.2rem 2.5rem;
        }

        main h1 {
          font-family: "Playfair Display", serif;
          font-size: 1.5rem;
          line-height: 1.2;
          margin-top: 1rem;
          margin-bottom: 0.6rem;
          letter-spacing: -0.01em;
        }

        h2 {
          font-size: 1.6rem;
          line-height: 1.3;
          margin-top: 2rem;
          margin-bottom: 1rem;
        }

        h2.section-subtitle {
          font-size: 1.1rem;
          line-height: 1.25;
          margin-top: 1.5rem;
          margin-bottom: 0.8rem;
        }

        p {
          font-size: 0.95rem;
        }

        main > *:first-child {
          margin-top: 0;
        }
      }

      /* ===== MOBILE (480px) ===== */
      @media (max-width: 480px) {
        .flag-strip {
          padding: 0.3rem 0.5rem;
          gap: 0.3rem;
        }

        .flag-btn {
          font-size: 0.6rem;
          padding: 0.22rem 0.4rem;
        }

        .brand-row {
          padding: 0.55rem 0.7rem 0.4rem;
        }

        .brand-name {
          font-size: 0.92rem;
        }

        .section-bar {
          font-size: 0.76rem;
          min-height: 42px;
        }

        main {
          padding: 1.1rem 0.85rem 2rem;
        }

        main h1 {
          font-size: 1.1rem;
          line-height: 1.15;
          margin-top: 0.6rem;
          margin-bottom: 0.4rem;
        }

        h2 {
          font-size: 1.3rem;
          line-height: 1.25;
          margin-top: 1.6rem;
          margin-bottom: 0.8rem;
        }

        h2.section-subtitle {
          font-size: 0.95rem;
          margin-top: 1.2rem;
          margin-bottom: 0.6rem;
        }

        p {
          font-size: 0.9rem;
          margin-bottom: 1.2rem;
        }

        footer {
          padding: 1.5rem 0.8rem;
          font-size: 0.75rem;
        }
      }

      /* ===== SMALL MOBILE (< 375px) ===== */
      @media (max-width: 374px) {
        .brand-name {
          font-size: 0.85rem;
        }

        .section-bar {
          font-size: 0.7rem;
        }

        main {
          padding: 1rem 0.8rem 2rem;
        }

        main h1 {
          font-size: 1rem;
        }

        h2 {
          font-size: 1.15rem;
          margin-top: 1.4rem;
          margin-bottom: 0.7rem;
        }

        p {
          font-size: 0.85rem;
          margin-bottom: 1rem;
        }
      }
    </style>
    {image ? <link rel="preload" as="image" href={image} /> : null}
  </head>

  <body>
    <header>
      <div class="header-inner">
        <h1>Víctor Cazorla Fernández</h1>
        <div class="subtitle">
          Dirección IT · Ciencias Ambientales · Ética profesional
        </div>
        <nav>
          {navItems.map((item) => (
            <a href={item.href} class={isActiveHref(item.href) ? "active" : ""}>
              {item.label}
            </a>
          ))}
        </nav>
        <div class="lang-switch-group" role="navigation" aria-label="Language selector">
          {languages.map((language: LanguageOption) => (
            <a
              class={"lang-switch" + (language.code === lang ? " active" : "")}
              href={languageHref(language.code)}
              aria-current={language.code === lang ? "page" : undefined}
            >
              <span class="flag-icon" aria-hidden="true">
                {language.code === "es" ? (
                  <svg viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Bandera española" focusable="false">
                    <rect width="60" height="30" fill="#AA151B" />
                    <rect y="10" width="60" height="10" fill="#F1BF00" />
                  </svg>
                ) : language.code === "en" ? (
                  <svg viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Union Jack" focusable="false">
                    <rect width="60" height="30" fill="#012169" />
                    <path d="M0 0 L60 30 M60 0 L0 30" stroke="#fff" stroke-width="6" />
                    <path d="M0 0 L60 30 M60 0 L0 30" stroke="#C8102E" stroke-width="4" />
                    <path d="M30 0 L30 30 M0 15 L60 15" stroke="#fff" stroke-width="10" />
                    <path d="M30 0 L30 30 M0 15 L60 15" stroke="#C8102E" stroke-width="6" />
                  </svg>
                ) : language.code === "fr" ? (
                  <svg viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Drapeau français" focusable="false">
                    <rect width="20" height="30" fill="#0055A4" />
                    <rect x="20" width="20" height="30" fill="#FFFFFF" />
                    <rect x="40" width="20" height="30" fill="#EF4135" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Senyera catalana" focusable="false">
                    <rect width="60" height="30" fill="#FFCE00" />
                    <path d="M0 3 H60 M0 10 H60 M0 17 H60 M0 24 H60" stroke="#D52B1E" stroke-width="4" />
                  </svg>
                )}
              </span>
              {language.label}
            </a>
          ))}
        </div>
      </div>

      <div class="header-mobile">
        <div class="flag-strip" role="navigation" aria-label="Selector de idioma">
          {languages.map((language: LanguageOption) => (
            <a
              class={"flag-btn" + (language.code === lang ? " active" : "")}
              href={languageHref(language.code)}
              aria-current={language.code === lang ? "page" : undefined}
            >
              <span class="flag-icon" aria-hidden="true">
                {language.code === "es" ? (
                  <svg viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Bandera española" focusable="false">
                    <rect width="60" height="30" fill="#AA151B" />
                    <rect y="10" width="60" height="10" fill="#F1BF00" />
                  </svg>
                ) : language.code === "en" ? (
                  <svg viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Union Jack" focusable="false">
                    <rect width="60" height="30" fill="#012169" />
                    <path d="M0 0 L60 30 M60 0 L0 30" stroke="#fff" stroke-width="6" />
                    <path d="M0 0 L60 30 M60 0 L0 30" stroke="#C8102E" stroke-width="4" />
                    <path d="M30 0 L30 30 M0 15 L60 15" stroke="#fff" stroke-width="10" />
                    <path d="M30 0 L30 30 M0 15 L60 15" stroke="#C8102E" stroke-width="6" />
                  </svg>
                ) : language.code === "fr" ? (
                  <svg viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Drapeau français" focusable="false">
                    <rect width="20" height="30" fill="#0055A4" />
                    <rect x="20" width="20" height="30" fill="#FFFFFF" />
                    <rect x="40" width="20" height="30" fill="#EF4135" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Senyera catalana" focusable="false">
                    <rect width="60" height="30" fill="#FFCE00" />
                    <path d="M0 3 H60 M0 10 H60 M0 17 H60 M0 24 H60" stroke="#D52B1E" stroke-width="4" />
                  </svg>
                )}
              </span>
              {language.code.toUpperCase()}
            </a>
          ))}
        </div>

        <div class="brand-row">
          <span class="brand-name">Víctor Cazorla Fernández</span>
        </div>

        <button
          type="button"
          class="section-bar"
          id="mobile-menu-btn"
          aria-expanded="false"
          aria-controls="mobile-menu-panel"
        >
          <svg class="burger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <g class="icon-open">
              <line x1="4" y1="7" x2="20" y2="7" />
              <line x1="4" y1="12" x2="20" y2="12" />
              <line x1="4" y1="17" x2="20" y2="17" />
            </g>
            <g class="icon-close" stroke="var(--accent-gold)">
              <line x1="5" y1="5" x2="19" y2="19" />
              <line x1="19" y1="5" x2="5" y2="19" />
            </g>
          </svg>
          {menuWord[lang]} · <b>{currentLabel}</b>
          <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>

        <div class="mobile-menu-panel" id="mobile-menu-panel">
          <nav>
            {navItems.map((item) => (
              <a href={item.href} class={isActiveHref(item.href) ? "active" : ""}>
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      © 2026 · Víctor Cazorla Fernández
    </footer>

    <!-- Como archivo externo (no inline) para cumplir la CSP
         "script-src 'self'" de public/_headers sin tener que
         añadir 'unsafe-inline'. -->
    <script is:inline src="/scripts/mobile-menu.js" defer></script>
  </body>
</html>